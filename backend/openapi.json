{
  "components": {
    "schemas": {
      "CheckResult": {
        "description": "One dependency's answer to a readiness probe.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "name",
          "status",
          "duration_ms"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "pass",
          "fail"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "Environment": {
        "enum": [
          "local",
          "dev",
          "prod"
        ],
        "type": "string"
      },
      "LivenessOut": {
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "environment"
        ],
        "title": "LivenessOut",
        "type": "object"
      },
      "ReadinessOut": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MyPaisa API",
    "version": "0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "liveness_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "readiness_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Every dependency the app needs answers",
        "tags": [
          "health"
        ]
      }
    }
  }
}
