// What every configuration shares (MA-165). React Native's generated settings come first; these sit on top.
#include "../ReactNativeSPM/ReactNativeSPM.xcconfig"

IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// The Release React framework is built with NDEBUG, and React's headers change shape with it, so an optimised build's
// Fabric views must see the same flag or they will not link.
GCC_PREPROCESSOR_DEFINITIONS[config=Dev] = $(inherited) NDEBUG=1
GCC_PREPROCESSOR_DEFINITIONS[config=Release] = $(inherited) NDEBUG=1

// Apple Silicon simulators only (MA-273).
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

// package.json sits beside the Xcode project, not one folder up, so React Native's bundling script is told so.
PROJECT_ROOT = $(SRCROOT)
