*.tfplan
*.tfstate
*.tfstate.*
crash.log

# The probe Lambda's zip, built by Terraform at plan time (MA-231).
infra/*/.build/

# Key and signing files never enter git (MA-363, finding F11; the App Store Connect key's home is MA-167).
