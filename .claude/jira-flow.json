{
  "version": 1,
  "jira": {
    "site": "https://duttaarun2015.atlassian.net",
    "cloudId": "81c51173-bbea-4905-bbc5-1a880fa348bb",
    "projectKey": "MA",
    "projectName": "mypaisaa-agent",
    "issueTypes": {
      "epic": "Epic",
      "story": "Story",
      "task": "Task",
      "bug": "Bug",
      "subtask": "Subtask"
    },
    "transitions": {
      "todo": "11",
      "inProgress": "21",
      "inReview": "31",
      "done": "41"
    },
    "fields": {
      "storyPoints": "customfield_10016",
      "sprint": "customfield_10020"
    },
    "labels": {
      "bug": "bug",
      "platforms": [],
      "themes": ["manual", "design"]
    },
    "taxonomy": ".claude/jira/taxonomy.md"
  },
  "git": {
    "baseBranch": "main",
    "protectedBranches": ["main"],
    "requireKey": true,
    "branch": "{key}-{slug}",
    "commit": "{key}: {subject}",
    "prTitle": "[{key}] {title}",
    "prTemplate": ".github/pull_request_template.md",
    "route": "gh"
  },
  "gates": [
    {
      "name": "plan-sync",
      "cwd": ".",
      "run": "python3 scripts/plan_sync.py selftest && python3 scripts/plan_sync.py check && python3 scripts/contrast_check.py --selftest && python3 scripts/contrast_check.py",
      "paths": ["**"]
    },
    {
      "name": "design-sync",
      "cwd": ".",
      "run": "python3 scripts/design_sync.py check",
      "paths": ["**"]
    },
    {
      "name": "board-fit",
      "cwd": ".",
      "run": "npm ci --prefix scripts --silent --no-audit --no-fund && node scripts/board_fit.js --selftest && node scripts/board_fit.js",
      "paths": ["docs/design/**", "scripts/board_fit*"]
    },
    {
      "name": "prototype",
      "cwd": ".",
      "run": "python3 docs/design/figures/make_demo_ledger.py | diff - docs/design/figures/demo-ledger-v4.json && npm ci --prefix prototype --silent --no-audit --no-fund && npm --prefix prototype run gate",
      "paths": ["prototype/**", "docs/design/figures/**", "docs/design/ds-v1/*.css", "docs/design/app-v1/support.js", "docs/design/app-v1/Prototype*", "docs/design/app-v1/prototype-v4*"]
    }
  ],
  "work": {
    "checkpoint": "phase",
    "commitEach": "never",
    "stateDir": ""
  },
  "approvals": {
    "createIssues": false,
    "comments": false
  },
  "ship": {
    "askBefore": ["merge"],
    "mergeMethod": "merge",
    "deleteBranchOnMerge": true,
    "waitForChecks": true
  }
}
