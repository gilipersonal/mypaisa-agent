{
  "version": 1,
  "jira": {
    "site": "https://duttaarun2015.atlassian.net",
    "cloudId": "81c51173-bbea-4905-bbc5-1a880fa348bb",
    "projectKey": "MA",
    "projectName": "mypaisaa-agent",
    "issueTypes": {
      "epic": "Epic",
      "story": "Story",
      "task": "Task",
      "bug": "Bug",
      "subtask": "Subtask"
    },
    "transitions": {
      "todo": "11",
      "inProgress": "21",
      "inReview": "31",
      "done": "41"
    },
    "fields": {
      "storyPoints": "customfield_10016",
      "sprint": "customfield_10020"
    },
    "labels": {
      "bug": "bug",
      "platforms": [],
      "themes": [
        "manual",
        "design",
        "retired"
      ]
    },
    "taxonomy": ".claude/jira/taxonomy.md"
  },
  "git": {
    "baseBranch": "main",
    "protectedBranches": [
      "main"
    ],
    "requireKey": true,
    "branch": "{key}-{slug}",
    "commit": "{key}: {subject}",
    "prTitle": "[{key}] {title}",
    "prTemplate": ".github/pull_request_template.md",
    "route": "gh"
  },
  "gates": [
    {
      "name": "plan-sync",
      "cwd": ".",
      "run": "python3 scripts/plan_sync.py selftest && python3 scripts/plan_sync.py check && python3 scripts/plan_sync.py pr-files",
      "paths": [
        "**"
      ]
    },
    {
      "name": "backend",
      "cwd": ".",
      "run": "scripts/backend_gates.sh",
      "paths": [
        "src/**",
        "tests/**",
        "pyproject.toml",
        "uv.lock",
        "scripts/backend_gates.sh"
      ]
    }
  ],
  "work": {
    "checkpoint": "phase",
    "commitEach": "never",
    "stateDir": ""
  },
  "approvals": {
    "createIssues": false,
    "comments": false
  },
  "ship": {
    "askBefore": [
      "merge"
    ],
    "mergeMethod": "merge",
    "deleteBranchOnMerge": true,
    "waitForChecks": true
  }
}
