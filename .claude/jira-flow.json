{
  "version": 1,
  "jira": {
    "site": "https://duttaarun2015.atlassian.net",
    "cloudId": "81c51173-bbea-4905-bbc5-1a880fa348bb",
    "projectKey": "MA",
    "projectName": "mypaisaa-agent",
    "issueTypes": {
      "epic": "Epic",
      "story": "Story",
      "task": "Task",
      "bug": "Bug",
      "subtask": "Subtask"
    },
    "transitions": {
      "todo": "11",
      "inProgress": "21",
      "inReview": "31",
      "done": "41"
    },
    "fields": {
      "storyPoints": "customfield_10016",
      "sprint": "customfield_10020"
    },
    "labels": {
      "bug": "bug",
      "platforms": [],
      "themes": [
        "manual",
        "design",
        "retired"
      ]
    },
    "taxonomy": ".claude/jira/taxonomy.md"
  },
  "git": {
    "baseBranch": "main",
    "protectedBranches": [
      "main"
    ],
    "requireKey": true,
    "branch": "{key}-{slug}",
    "commit": "{key}: {subject}",
    "prTitle": "[{key}] {title}",
    "prTemplate": ".github/pull_request_template.md",
    "route": "gh"
  },
  "gates": [
    {
      "name": "plan-sync",
      "cwd": ".",
      "run": "python3 scripts/plan_sync.py selftest && python3 scripts/plan_sync.py check && python3 scripts/plan_sync.py pr-files",
      "paths": [
        "**"
      ]
    },
    {
      "name": "backend",
      "cwd": ".",
      "run": "scripts/backend_gates.sh",
      "paths": [
        "backend/**",
        "scripts/local/**",
        "scripts/backend_gates.sh",
        ".pre-commit-config.yaml"
      ]
    },
    {
      "name": "web",
      "cwd": ".",
      "run": "scripts/web_gates.sh",
      "paths": [
        "web/**",
        "backend/openapi.json",
        "scripts/web_gates.sh",
        ".pre-commit-config.yaml",
        "docs/design/ds-v1/tokens.css",
        "docs/design/ds-v1/motion.css"
      ]
    },
    {
      "name": "ios",
      "cwd": ".",
      "run": "scripts/ios_gates.sh",
      "paths": [
        "ios/**",
        "web/src/lib/**",
        "web/pnpm-workspace.yaml",
        "web/pnpm-lock.yaml",
        "scripts/ios_gates.sh",
        "scripts/ios_tokens.py",
        "docs/design/ds-v1/tokens.css"
      ]
    },
    {
      "name": "security",
      "cwd": ".",
      "run": "scripts/security_scan.sh",
      "paths": [
        "**"
      ]
    },
    {
      "name": "infra",
      "cwd": ".",
      "run": "scripts/infra_gates.sh",
      "paths": [
        "infra/**",
        "scripts/infra_gates.sh",
        "scripts/plan_comment.py",
        "scripts/release.py",
        "scripts/smoke.py",
        ".github/workflows/release.yml"
      ]
    }
  ],
  "work": {
    "checkpoint": "phase",
    "commitEach": "never",
    "stateDir": ""
  },
  "approvals": {
    "createIssues": false,
    "comments": false
  },
  "ship": {
    "askBefore": [
      "merge"
    ],
    "mergeMethod": "merge",
    "deleteBranchOnMerge": true,
    "waitForChecks": true
  }
}
